# Copy to .env (git-ignored) and fill in:  cp .env.example .env
# Never commit keys; the pre-commit hook and CI block obvious key patterns.

# Default provider: Anthropic Messages API
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Any OpenAI-compatible endpoint instead (uncomment all four):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1

# Optional cap on output tokens per call (Anthropic)
# LLM_MAX_TOKENS=1024
